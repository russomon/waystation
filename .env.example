# ─── Backblaze B2 (S3-compatible) ───
B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=orbitxfer-transfers
B2_KEY_ID=
B2_APP_KEY=

# ─── Cloudflare CDN (download path) ───
CDN_BASE=https://cdn.orbitxfer.app
CDN_TOKEN_SECRET=replace-with-long-random-string

# ─── B2 Event Notifications (webhook auth) ───
B2_EVENT_SIGNING_SECRET=replace-with-rule-signing-secret

# ─── Gateway ↔ pipeline ───
PORT=8787
GATEWAY_PUBLIC_URL=http://localhost:8787
PIPELINE_URL=http://localhost:8000
PIPELINE_SHARED_SECRET=replace-with-shared-secret
# Local development starts the shipped Docker worker on :8001 by default, so
# the checked Cloud compute option uses the same tool-complete image as hosted
# compute. Set false only to run host-only and accept explicit local fallback.
WAYSTATION_LOCAL_CLOUD_WORKER=true

# ─── GMI Cloud (AI inference, used by the pipeline worker) ───
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com
# Optional: pick any chat model from GET /v1/models (default: openai/gpt-4o-mini)
GMI_MODEL=
# Optional AI Interpretive Pass. Default false means no shadow-model spend.
AI_INTERPRETIVE_SHADOW=false
AI_INTERPRETIVE_SHADOW_MAX_PACKETS=4
# Dedicated user-visible Genblaze/GMI run. Both gateway and worker gates must
# be true, and the sender must explicitly select the service. Defaults spend-off.
ALLOW_AI_INTERPRETIVE=false
AI_INTERPRETIVE_RUN_ENABLED=false
AI_INTERPRETIVE_PROVIDER=gmicloud
AI_INTERPRETIVE_PLANNER_MODEL=
AI_INTERPRETIVE_VISUAL_MODEL=
AI_INTERPRETIVE_AUDIO_MODEL=
AI_INTERPRETIVE_SYNTHESIS_MODEL=
AI_INTERPRETIVE_JURY_MODEL=
# shadow: AI decision is recorded only; hold: AI can hold; enforce: qualified
# and corroborated findings in the versioned authority policy can reject.
AI_INTERPRETIVE_AUTHORITY_MODE=shadow
AI_INTERPRETIVE_FALLBACK_PROVIDER=
AI_INTERPRETIVE_FALLBACK_MODEL=
AI_INTERPRETIVE_TIMEOUT_SECONDS=120
AI_INTERPRETIVE_MAX_CONCURRENCY=3
AI_INTERPRETIVE_STAGE_MAX_ATTEMPTS=2
AI_INTERPRETIVE_RETRY_DELAY_SECONDS=5
AI_INTERPRETIVE_MAX_FRAMES=4
AI_INTERPRETIVE_MAX_AUDIO_WINDOWS=1
AI_INTERPRETIVE_MAX_OUTPUT_TOKENS=4096
AI_INTERPRETIVE_PLANNER_MAX_OUTPUT_TOKENS=4096
AI_INTERPRETIVE_SYNTHESIS_MAX_OUTPUT_TOKENS=6144

# AI-selected poster frame. One bounded GMI vision call when thumbnailing is
# selected and GMI_API_KEY is configured; otherwise an explicit local fallback.
AI_THUMBNAIL_MODEL=google/gemini-3.5-flash
AI_THUMBNAIL_CANDIDATES=6
AI_THUMBNAIL_TIMEOUT_SECONDS=90
AI_THUMBNAIL_SCENE_SCAN_MAX_SECONDS=300

# ─── Provenance (pipeline worker) ───
# Lock the manifest under B2 Object Lock (COMPLIANCE/WORM) for N days. Requires
# the bucket to be created with Object Lock enabled. 0 = off (dev default).
MANIFEST_LOCK_DAYS=0

# ─── Deterministic QC policy overrides (optional) ───
# The checked-in U.S. broadcast XDCAM baseline is immutable. To apply a
# customer-specific variation without editing it, provide a JSON object of
# nested rule values. Unknown keys fail closed. The effective override and hash
# are recorded in qc_report.json. Example (keep unset for the v1 baseline):
#WAYSTATION_BROADCAST_POLICY_OVERRIDES={"audio":{"total_channels":8}}

# ─── Hosted production upload ceilings ───
# Production can accept 350 GiB transfer-only uploads when
# ALLOW_ROOT_ONLY_UPLOADS=true. Files above VERIFIED_RANGE_MAX_BYTES skip the
# bao outboard sidecar because the current outboard implementation buffers it
# in browser memory; the whole-file BLAKE3 root is still stored.
#MAX_UPLOAD_BYTES=375809638400
#VERIFIED_RANGE_MAX_BYTES=17179869184
#ALLOW_ROOT_ONLY_UPLOADS=true
#MAX_QC_BYTES=107374182400
#MAX_ACTIVE_UPLOADS_PER_SESSION=1
#MAX_DAILY_JOBS=20

# ─── Scratch data disk (hosted production only) ───
# The worker does all heavy ffmpeg/QC work in temporary directories. In
# production those must land on a dedicated data disk, not the root filesystem
# and not the container's writable layer. docker-compose.prod.yml bind-mounts
# this path to /scratch and points TMPDIR at /scratch/tmp.
#
# Leave UNSET for local development: docker-compose.yml is unchanged and keeps
# using ordinary container temp space.
#
# Prepare the disk once, then validate:
#   bash scripts/preflight-scratch.sh --create
#
# The bind uses create_host_path:false, so a missing directory makes the worker
# refuse to start rather than silently filling the root disk.
#WAYSTATION_SCRATCH=/mnt/waystation-scratch/waystation
