# ─── Backblaze B2 (S3-compatible) ───
B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=orbitxfer-transfers
B2_KEY_ID=
B2_APP_KEY=

# ─── Cloudflare CDN (download path) ───
CDN_BASE=https://cdn.orbitxfer.app
CDN_TOKEN_SECRET=replace-with-long-random-string

# ─── B2 Event Notifications (webhook auth) ───
B2_EVENT_SIGNING_SECRET=replace-with-rule-signing-secret

# ─── Gateway ↔ pipeline ───
PORT=8787
GATEWAY_PUBLIC_URL=http://localhost:8787
PIPELINE_URL=http://localhost:8000
PIPELINE_SHARED_SECRET=replace-with-shared-secret

# ─── GMI Cloud (AI inference, used by the pipeline worker) ───
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com
