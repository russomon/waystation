{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waystation.invalid/schemas/ai-shadow-review-1.0.json",
  "title": "Waystation AI shadow reviewer disposition",
  "type": "object",
  "additionalProperties": true,
  "required": ["review_id", "packet_id", "observation_id", "source_kind", "split", "model_outcome", "human_label", "disposition", "rationale", "evidence_references", "reviewer", "provenance"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["human_review", "synthetic_fixture"]},
    "split": {"enum": ["development", "holdout"]},
    "model_outcome": {"enum": ["concern", "no_concern_observed", "not_checked"]},
    "human_label": {"enum": ["concern", "no_concern", "not_determinable"]},
    "disposition": {"enum": ["agree", "disagree", "needs_review", "false_positive"]},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "recorded_at"],
      "properties": {"reviewer_id": {"type": "string"}, "recorded_at": {"type": "string", "format": "date-time"}}
    },
    "provenance": {
      "type": "object",
      "required": ["model", "prompt_sha256", "packet_input_sha256", "schema_version"],
      "properties": {
        "model": {"type": "string"},
        "prompt_sha256": {"type": "string"},
        "packet_input_sha256": {"type": "string"},
        "schema_version": {"type": "string"}
      }
    }
  }
}
