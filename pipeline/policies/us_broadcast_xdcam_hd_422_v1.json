{
  "policy_id": "us_broadcast_xdcam_hd_422_baseline",
  "version": "1.2.0",
  "profile_name": "us_broadcast_xdcam_hd_422_v1",
  "label": "U.S. Broadcast MXF OP1a / XDCAM HD 4:2:2 Baseline v1.2",
  "scope": "A Waystation house baseline for one common U.S. HD broadcast delivery shape. It is not a universal network specification or evidence of acceptance by any broadcaster.",
  "assumptions": [
    "single-file MXF OP1a delivery",
    "XDCAM HD 4:2:2 MPEG-2 at nominal 50 Mb/s",
    "1920x1080, 30000/1001 interlaced top-field-first, 8-bit 4:2:2",
    "one 24-bit 48 kHz PCM stereo programme track",
    "SMPTE drop-frame start timecode and material-package UMID present",
    "captions supplied as an embedded stream or SRT/VTT sidecar",
    "1 to 5 seconds of black at head and tail",
    "programme loudness -24 LKFS +/-2 LU and true peak at or below -2 dBTP",
    "BT.709 colour metadata, 16:9 display aspect, square pixels, and aligned programme starts",
    "Phase 2 visual/audio artifact thresholds are advisory calibration candidates, not broadcaster acceptance rules"
  ],
  "rules": {
    "wrapper": {
      "format_names": ["mxf"],
      "op1a_ul": "060e2b34.04010101.0d010201.01010900",
      "required_metadata_tags": ["material_package_umid", "timecode"]
    },
    "video": {
      "min_tracks": 1,
      "codec_names": ["mpeg2video"],
      "profiles": ["4:2:2"],
      "frame_rate": {"numerator": 30000, "denominator": 1001},
      "raster": {"width": 1920, "height": 1080},
      "field_orders": ["tt"],
      "bit_depth": 8,
      "pixel_formats": ["yuv422p"],
      "sample_aspect_ratio": "1:1",
      "display_aspect_ratio": "16:9",
      "colorimetry": {
        "color_range": ["tv"],
        "color_space": ["bt709"]
      },
      "bit_rate": {"target": 50000000, "tolerance": 5000000},
      "gop": {"max_frames": 15, "scan_frames": 1800, "scan_windows": 3},
      "timestamp_gap_multiplier": 2.5,
      "duration_tolerance_seconds": 0.5
    },
    "audio": {
      "min_tracks": 1,
      "total_channels": 2,
      "codecs": ["pcm_s24le"],
      "sample_rate": 48000,
      "bit_depth": 24,
      "max_video_start_offset_seconds": 0.034,
      "loudness": {"target_lkfs": -24.0, "tolerance_lu": 2.0},
      "true_peak": {"max_dbtp": -2.0}
    },
    "captions": {"required": true},
    "signal": {
      "black_head": {"min_seconds": 1.0, "max_seconds": 5.0},
      "black_tail": {"min_seconds": 1.0, "max_seconds": 5.0},
      "boundary_detection_tolerance_seconds": 0.1,
      "unexpected_black_min_seconds": 0.5,
      "freeze_min_seconds": 2.0,
      "silence_min_seconds": 2.0,
      "max_reported_events": 100,
      "program_black_authority": "advisory",
      "freeze_authority": "advisory",
      "silence_authority": "advisory",
      "visual_artifact_authority": "advisory",
      "legal_range_authority": "advisory"
    },
    "qctools": {
      "window_seconds": 8.0,
      "max_windows": 3,
      "authority": "advisory",
      "calibration_state": "pending_real_accepted_rejected_corpus"
    },
    "visual_quality": {
      "window_seconds": 4.0,
      "max_windows": 3,
      "blockiness_warn_p95": 16.0,
      "blur_warn_p95": 15.0,
      "banding_max_used_bits": 6,
      "banding_max_entropy": 0.65,
      "banding_min_luma_span": 64,
      "temporal_outlier_warn_max": 0.02,
      "repeat_warn_max": 0.02,
      "crop_max_fraction": 0.03,
      "authority": "advisory",
      "calibration_state": "pending_real_accepted_rejected_corpus"
    },
    "audio_quality": {
      "window_seconds": 8.0,
      "max_windows": 3,
      "phase_minimum_mean": -0.2,
      "phase_minimum_sample": -0.9,
      "phase_max_negative_fraction": 0.1,
      "clipping_peak_dbfs": -0.05,
      "clipping_flat_factor": 0.0,
      "click_peak_dbfs": -1.0,
      "click_max_rms_dbfs": -25.0,
      "click_min_difference": 0.5,
      "silence_noise_db": -50.0,
      "dropout_min_seconds": 0.05,
      "persistent_silence_seconds": 2.0,
      "channel_max_rms_spread_db": 12.0,
      "dead_channel_rms_dbfs": -80.0,
      "max_reported_events": 100,
      "authority": "advisory",
      "calibration_state": "pending_real_accepted_rejected_corpus"
    },
    "caption_quality": {
      "eof_tolerance_seconds": 1.0,
      "long_gap_advisory_seconds": 120.0,
      "max_reported_events": 100,
      "authority": "advisory"
    },
    "metadata_cross_validation": {
      "sources": ["ffprobe", "mediainfo", "mediaconch"],
      "authority": "advisory"
    }
  }
}
